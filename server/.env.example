# Copy to .env and set your actual values
SUPABASE_URL=
# Prefer service role key on server-side; otherwise it will fall back to anon key
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback if you only need public access
SUPABASE_ANON_KEY=

# Optional: override storage bucket name (defaults to product-images)
# STORAGE_BUCKET=product-images

# Optional: sentence-transformers cache directory
# TRANSFORMERS_CACHE=.cache/transformers

# Optional: Gemini API key for /suggest endpoint
# Get one at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
